# Copy to backend/.env and adjust.

# PostgreSQL started by docker-compose.yml in the project root.
DATABASE_URL=postgresql+psycopg://jobs:jobs@localhost:5432/jobs
# Quick local alternative without Docker:
# DATABASE_URL=sqlite:///./dev.db

# Change this to a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Skill extraction: auto | llm | keyword
#   auto    -> Claude API when ANTHROPIC_API_KEY is set, otherwise keyword matching
#   llm     -> always Claude (also works with an `ant auth login` profile)
#   keyword -> dictionary matching only (no API cost; also the evaluation baseline)
SKILL_EXTRACTOR=auto

# LLM provider: anthropic | ollama
#   ollama -> free local model, no API key (https://ollama.com, then `ollama pull <model>`)
LLM_PROVIDER=anthropic
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=exaone3.5:2.4b-instruct-q4_K_M

# Claude (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Text similarity: auto | sbert | tfidf
#   auto -> Sentence-BERT if requirements-ml.txt is installed, otherwise TF-IDF
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Match = 100 * (WEIGHT_SKILL * skill_overlap + WEIGHT_TEXT * text_similarity)
WEIGHT_SKILL=0.7
WEIGHT_TEXT=0.3
